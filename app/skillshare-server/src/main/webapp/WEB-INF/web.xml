<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
  version="5.0">

	<!-- Servlets -->
   <servlet>
        <servlet-name>chatService</servlet-name>
        <servlet-class>it.unibo.ChatServiceImpl</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>chatService</servlet-name>
        <url-pattern>/app/chatService</url-pattern>
    </servlet-mapping>
   <servlet>
    <servlet-name>accessoServlet</servlet-name>
    <servlet-class>it.unibo.AccessoServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>accessoServlet</servlet-name>
    <url-pattern>/app/accesso</url-pattern>
  </servlet-mapping>
   <servlet>
    <servlet-name>registrazioneServlet</servlet-name>
    <servlet-class>it.unibo.RegistrazioneServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>registrazioneServlet</servlet-name>
    <url-pattern>/app/registrazione</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>profileServlet</servlet-name>
    <servlet-class>it.unibo.ProfileServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>profileServlet</servlet-name>
    <url-pattern>/app/profile</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>annuncioServlet</servlet-name>
    <servlet-class>it.unibo.AnnuncioServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>annuncioServlet</servlet-name>
    <url-pattern>/app/annuncio</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>marketplaceServlet</servlet-name>
    <servlet-class>it.unibo.MarketplaceServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>marketplaceServlet</servlet-name>
    <url-pattern>/app/marketplace</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>richiestaScambioServlet</servlet-name>
    <servlet-class>it.unibo.RichiestaScambioServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>richiestaScambioServlet</servlet-name>
    <url-pattern>/app/richiestaScambio</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>recensioneServlet</servlet-name>
    <servlet-class>it.unibo.RecensioneServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>recensioneServlet</servlet-name>
    <url-pattern>/app/recensione</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>reputazioneServlet</servlet-name>
    <servlet-class>it.unibo.ReputazioneServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>reputazioneServlet</servlet-name>
    <url-pattern>/app/reputazione</url-pattern>
  </servlet-mapping>

  <!-- Upload della foto profilo: multipart, fuori dal meccanismo RPC di GWT -->
  <servlet>
    <servlet-name>fotoProfiloUploadServlet</servlet-name>
    <servlet-class>it.unibo.FotoProfiloUploadServlet</servlet-class>
    <multipart-config>
      <max-file-size>2097152</max-file-size>
      <max-request-size>4194304</max-request-size>
      <file-size-threshold>262144</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>fotoProfiloUploadServlet</servlet-name>
    <url-pattern>/app/uploadFotoProfilo</url-pattern>
  </servlet-mapping>

  <!-- Lettura delle foto caricate: stanno in DATA_DIR, fuori dalla webapp -->
  <servlet>
    <servlet-name>fotoProfiloServlet</servlet-name>
    <servlet-class>it.unibo.FotoProfiloServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>fotoProfiloServlet</servlet-name>
    <url-pattern>/app/fotoProfilo/*</url-pattern>
  </servlet-mapping>

	<!-- Default page to serve -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

</web-app>
